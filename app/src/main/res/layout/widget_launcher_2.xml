<?xml version="1.0" encoding="utf-8"?>
<!-- 2×1 widget: 1 row × 2 cells. Fixed-cell direct-render layout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/launcher_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:weightSum="2"
    android:padding="6dp"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/cell_root_0"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:background="@android:color/transparent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="15" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="85"
            android:orientation="horizontal"
            android:weightSum="100">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="17" />

            <ImageView
                android:id="@+id/cell_icon_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="66"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="17" />

        </LinearLayout>

        <TextView
            android:id="@+id/cell_label_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:maxEms="8"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:gravity="center" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cell_root_1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:background="@android:color/transparent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="15" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="85"
            android:orientation="horizontal"
            android:weightSum="100">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="17" />

            <ImageView
                android:id="@+id/cell_icon_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="66"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="17" />

        </LinearLayout>

        <TextView
            android:id="@+id/cell_label_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:maxEms="8"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:gravity="center" />
    </LinearLayout>

</LinearLayout>
